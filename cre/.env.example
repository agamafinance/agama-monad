# Copy to .env (never committed). `cre workflow simulate --broadcast` reads it.
# The key that pays for the write through the mock forwarder: any funded
# Monad testnet key, it holds no role in the protocol.
CRE_ETH_PRIVATE_KEY=
# Chainlink Data Streams testnet credentials (secrets.yaml maps them).
CRE_DS_KEY=
CRE_DS_SECRET=
